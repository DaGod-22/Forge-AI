# Forge AI local/server configuration
FORGE_PORT=5173
FORGE_STATE_DIR=.forge
FORGE_WORKSPACE_DIR=workspace/projects
# Optional master secret for encrypting stored integration credentials.
# If omitted, Forge creates a local gitignored development key under .forge/secrets/master.key.
FORGE_MASTER_KEY=
# Optional AI provider credentials for real model-backed planning/coding adapters.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: use existing GitHub auth for GitHub Models only when the endpoint is reachable in your environment.
GITHUB_MODELS_ENABLE=0
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
# Optional deployment/integration tokens may also be stored through the Forge UI.
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
